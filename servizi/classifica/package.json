{
  "name": "sql-academy-classifica",
  "private": true,
  "description": "Servizio della classifica di SQL Academy: punti per tema su Cloudflare D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "prova": "node prova.mjs",
    "migra:locale": "wrangler d1 migrations apply sql-academy-classifica --local",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "typescript": "~5.5.2",
    "wrangler": "4.156.0"
  }
}
